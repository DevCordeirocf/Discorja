{
  "name": "discorja",
  "version": "0.9.12",
  "private": true,
  "description": "Compartilhe uma janela ou tela com seus amigos.",
  "author": "Discorja",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "server:dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server/index.js",
    "server:check": "node --env-file-if-exists=.env scripts/check-server.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs && npm run server:build",
    "audio:build": "node scripts/build-audio-capture.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test:rooms": "node scripts/rooms-smoke.mjs",
    "test:multistream": "node scripts/multistream-smoke.mjs",
    "test:accessibility": "node scripts/accessibility-smoke.mjs",
    "test:logs": "node scripts/logs-smoke.mjs",
    "test:soak": "node scripts/multistream-smoke.mjs --soak-minutes=30",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "node scripts/prepare-release.mjs && npm run audio:build && npm run build && electron-builder --config electron-builder.config.cjs --win nsis",
    "pack:win": "node scripts/prepare-release.mjs && npm run audio:build && npm run build && electron-builder --config electron-builder.config.cjs --win --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "js-yaml": "5.5.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@electron/get@3.1.0": {
      "global-agent": "4.1.3"
    }
  }
}
