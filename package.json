{
  "name": "discorja",
  "version": "0.2.4",
  "private": true,
  "description": "Compartilhe uma janela ou tela com seus amigos.",
  "author": "Discorja",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "server:dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs && npm run server:build",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "node scripts/prepare-release.mjs && npm run build && electron-builder --config electron-builder.config.cjs --win nsis",
    "pack:win": "node scripts/prepare-release.mjs && npm run build && electron-builder --config electron-builder.config.cjs --win --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
