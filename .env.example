# Desenvolvimento: copie para .env na raiz, sem versionar o arquivo resultante.
# npm run dev e npm run server:dev carregam .env; builds, instalado e server:start nao.
# Todos os participantes precisam usar o mesmo endpoint publico para uso pela internet.
DISCORJA_SIGNALING_URL=ws://127.0.0.1:8787
# JSON completo de RTCIceServer[]. Substitui a lista padrao; [] desativa STUN/TURN.
# TURN e configurado nos clientes; credenciais devem ser temporarias e privadas.
DISCORJA_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Sinalização. Em um container use HOST=0.0.0.0 e termine TLS em um proxy.
HOST=127.0.0.1
PORT=8787
MAX_VIEWERS=9
# Participantes totais = MAX_VIEWERS + 1. Até todos os 10 podem publicar.
# Cada pessoa continua assistindo a uma tela por vez; P2P usa o upload de cada host.
MAX_PUBLISHERS=10
ROOM_TTL_MS=14400000
MAX_ROOMS=5
MAX_CLIENTS=20
RESUME_GRACE_MS=20000
# Sem token, /api/stats retorna 404. Gere um segredo aleatorio, minimo 32 caracteres.
# Somente no servidor; nunca embuta no aplicativo ou envie por URL.
STATS_TOKEN=
# Em producao com apps instalados, use apenas ALLOWED_ORIGINS=app://discorja.
# ALLOWED_ORIGINS=app://discorja,http://127.0.0.1:5173,http://localhost:5173

# Assinatura e releases: configure no ambiente do build ou GitHub Actions,
# conforme docs/releases.md. Nao coloque certificado, senha ou token neste exemplo.
